# Frontend — copy to `.env.local` as needed
# VITE_API_BASE_URL=http://localhost:3000/api
# Dev proxy: set VITE_API_BASE_URL=/api and VITE_WS_URL= (empty) in .env.development.local,
# then point the Vite proxy at the backend. Avoids CORS when opening the app via a LAN IP.
# VITE_PROXY_TARGET=https://studysync-backend-5i2a.onrender.com
# Public site origin used for canonical URLs, Open Graph, sitemap, and robots Sitemap line.
# Example: VITE_SITE_URL=https://your-frontend.onrender.com
# VITE_SITE_URL=
# LiveKit credentials come only from the backend call payload (call.url + call.token).
# Do not put LIVEKIT_API_KEY / LIVEKIT_API_SECRET in the frontend.
